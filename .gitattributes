# Tüm metin dosyaları LF (Windows + Mac uyumu için kritik)
* text=auto eol=lf

# Windows-spesifik script'ler CRLF kalmalı
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

