# Bu dosya REPO'da kalır, gerçek .env dosyası kalmaz (gitignore).
# Her makinede `cp .env.example .env` yap ve değerleri doldur.

# --- Tailscale hostnameleri (her makinede dolu olmalı) ---
WINDOWS_HOST=desktop-ert7724.your-tailnet.ts.net
MAC_HOST=macbook-baris.your-tailnet.ts.net

# --- Windows'taki Docker servisleri (Mac'ten erişilirken bu kullanılır) ---
PG_HOST=${WINDOWS_HOST}
PG_PORT=5432
PG_USER=ortaklasa
PG_PASSWORD=change-me
PG_DB=ortaklasa

REDIS_HOST=${WINDOWS_HOST}
REDIS_PORT=6379

OLLAMA_HOST=${WINDOWS_HOST}
OLLAMA_PORT=11434

# --- SSH ---
SSH_USER=baris
SSH_KEY_PATH=~/.ssh/ortaklasa
